DATABASE_URL=postgres://bidyut:bidyut_dev@localhost:5432/bidyut
REDIS_URL=redis://localhost:6379
DEVICE_TOKEN_SECRET="generate it with openssl rand -hex 32"
TRUST_PROXY=false
RUST_LOG=info
LOG_FORMAT=pretty
BIND_ADDR=0.0.0.0:3000
METRICS_ADDR=127.0.0.1:9090
DB_MAX_CONNECTIONS=10
REQUEST_TIMEOUT_SECS=10
MAX_BODY_BYTES=16384
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-secret
AWS_DEFAULT_REGION=ap-southeast-1
RESTIC_REPOSITORY=s3:s3.ap-southeast-1.amazonaws.com/BUCKET/bidyut
RESTIC_PASSWORD_FILE=/etc/bidyut-restic-password
TELEGRAM_BOT_TOKEN="telegram bot token" 